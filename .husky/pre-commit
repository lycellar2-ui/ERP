#!/bin/sh

# ==============================================================================
# 🛡️ DOCS GUARDIAN — Pre-commit Hook
# ==============================================================================
# Enforces: If you change code in src/, you MUST also update docs/
# This prevents documentation drift that causes regression bugs.
# ==============================================================================

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Get staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

# Check if any src/ files are staged
SRC_CHANGED=$(echo "$STAGED_FILES" | grep -E "^wine-erp/src/" | head -20)
PRISMA_CHANGED=$(echo "$STAGED_FILES" | grep -E "^wine-erp/prisma/schema\.prisma$")
DOCS_CHANGED=$(echo "$STAGED_FILES" | grep -E "^docs/|^CODEBASE\.md")

# If no source code changes, skip check
if [ -z "$SRC_CHANGED" ] && [ -z "$PRISMA_CHANGED" ]; then
    exit 0
fi

# === HARD BLOCK: Prisma schema changed without docs ===
if [ -n "$PRISMA_CHANGED" ] && [ -z "$DOCS_CHANGED" ]; then
    echo ""
    echo "${RED}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo "${RED}║  🚫 BLOCKED: Prisma schema changed without docs update!    ║${NC}"
    echo "${RED}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo "${YELLOW}You modified:${NC} prisma/schema.prisma"
    echo ""
    echo "${CYAN}You MUST update at least one of:${NC}"
    echo "  📄 docs/architecture/database-schema.md"
    echo "  📄 docs/README.md (model/enum counts)"
    echo "  📄 docs/llms.txt (model/enum counts)"
    echo "  📄 CODEBASE.md (model/enum counts)"
    echo ""
    echo "${YELLOW}To bypass (emergency only):${NC} git commit --no-verify"
    echo ""
    exit 1
fi

# === SOFT WARNING: Source code changed without docs ===
if [ -n "$SRC_CHANGED" ] && [ -z "$DOCS_CHANGED" ]; then
    # Check if it's a significant change (new files, actions.ts, etc.)
    SIGNIFICANT=$(echo "$SRC_CHANGED" | grep -E "actions.*\.ts$|page\.tsx$|Client\.tsx$" | head -5)
    NEW_FILES=$(git diff --cached --name-only --diff-filter=A | grep -E "^wine-erp/src/" | head -5)

    if [ -n "$NEW_FILES" ]; then
        echo ""
        echo "${RED}╔══════════════════════════════════════════════════════════════╗${NC}"
        echo "${RED}║  🚫 BLOCKED: New source files added without docs update!    ║${NC}"
        echo "${RED}╚══════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo "${YELLOW}New files:${NC}"
        echo "$NEW_FILES" | sed 's/^/  📁 /'
        echo ""
        echo "${CYAN}You MUST update the relevant module spec:${NC}"
        echo "  📄 docs/modules/<module>.md"
        echo "  📄 docs/README.md (if new route/module)"
        echo ""
        echo "${YELLOW}To bypass (emergency only):${NC} git commit --no-verify"
        echo ""
        exit 1
    fi

    if [ -n "$SIGNIFICANT" ]; then
        echo ""
        echo "${YELLOW}╔══════════════════════════════════════════════════════════════╗${NC}"
        echo "${YELLOW}║  ⚠️  WARNING: Significant code changes without docs update  ║${NC}"
        echo "${YELLOW}╚══════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo "${YELLOW}Changed files:${NC}"
        echo "$SIGNIFICANT" | sed 's/^/  📝 /'
        echo ""
        echo "${CYAN}Consider updating:${NC}"
        echo "  📄 docs/modules/<module>.md — for feature changes"
        echo "  📄 docs/bug-fix-lessons.md  — for bug fixes"
        echo ""
        echo "${GREEN}Proceeding with commit...${NC} (This is a warning, not a block)"
        echo ""
    fi
fi

exit 0
